datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  role          String         @default("STUDENT") // ADMIN, STUDENT
  phone         String?        @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  studentAccess Student?
  notifications Notification[]
  sessions      Session[]
}

model Student {
  id               String              @id @default(uuid())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String              @unique
  studentId        String              @unique
  fullName         String
  age              Int
  batchType        String              // BEGINNER, INTERMEDIATE, ADVANCED
  coachName        String?
  contactDetails   String?
  enrollmentStatus String              @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, GRADUATED
  bio              String?             @default("Aspiring Table Tennis Athlete")
  socialTwitter    String?
  socialInsta      String?
  fees             AcademyFee[]
  tournaments      TournamentPayment[]
  chatMessages     ChatMessage[]       @relation("SentMessages")

  @@index([batchType])
  @@index([enrollmentStatus])
}

model AcademyFee {
  id          String    @id @default(uuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId   String
  amount      Int       // Stored in Paise (1 INR = 100 Paise) to eliminate IEEE 754 float rounding issues
  dueDate     DateTime
  status      String    @default("DUE") // PAID, DUE, OVERDUE
  interval    String    @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY, ONE_TIME
  paymentDate DateTime?
  receiptUrl  String?
  qrCodeHash  String?
  method      String?   // UPI, CARD, CASH

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Tournament {
  id                  String              @id @default(uuid())
  name                String
  date                DateTime
  venue               String
  level               String
  entryFee            Int                 // Stored in Paise (1 INR = 100 Paise)
  eligibilityCriteria String?
  createdAt           DateTime            @default(now())
  participants        TournamentPayment[]

  @@index([date])
}

model TournamentPayment {
  id                  String     @id @default(uuid())
  student             Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId           String
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  tournamentId        String
  amountPaid          Int        // Stored in Paise (1 INR = 100 Paise)
  paymentStatus       String     @default("PENDING") // PAID, PENDING
  paymentDate         DateTime?
  confirmationDetails String?

  @@unique([studentId, tournamentId]) // Prevent duplicate registration at the database level
  @@index([studentId])
  @@index([tournamentId])
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // FEE, TOURNAMENT, GENERAL
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Broadcast {
  id        String   @id @default(uuid())
  title     String
  message   String
  author    String   @default("Academy Admin")
  category  String   @default("GENERAL") // GENERAL, TOURNAMENT, HOLIDAY, URGENT
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ChatMessage {
  id          String   @id @default(uuid())
  content     String?
  sender      Student? @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  senderId    String?
  senderName  String
  isAdmin     Boolean  @default(false)
  category    String   // GLOBAL, BATCH, PRIVATE
  batchType   String?  // Filters chat for BEGINNER, INTERMEDIATE, ADVANCED
  recipientId String?  // ID of the student receiving the message (if PRIVATE)
  fileUrl     String?
  fileName    String?
  fileType    String?  // IMAGE, PDF, DOCUMENT
  createdAt   DateTime @default(now())

  @@index([category, batchType])
  @@index([recipientId])
  @@index([createdAt])
}

model Session {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
