# PostgreSQL Database Connection String
# e.g., postgresql://username:password@localhost:5432/tabletennis?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/tabletennis?schema=public"

# Session Encryption / Signing Secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# Runtime Environment (development, test, production)
NODE_ENV="development"

# Server Port (optional, default: 3000)
PORT="3000"

# Razorpay Payment Gateway Credentials (optional in dev, required for live cards/netbanking)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_32_chars"

# Academy UPI Configuration
UPI_VPA="tta.academy@upi"
UPI_MERCHANT_NAME="Table Tennis Academy"

# Mobile Authorisation & SMS Configuration (console | msg91 | twilio)
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

